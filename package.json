{
  "name": "wow-pad-planner",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun run setup",
    "setup": "lefthook install",
    "moon": "moon",
    "check": "moon run :check",
    "legacy:build": "python3 -I build.py",
    "legacy:test": "bun run legacy:build && node tools/page-test.mjs && lua tools/addon-test.lua",
    "catalog": "python3 -I tools/build-catalog.py"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@moonrepo/cli": "2.6.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
